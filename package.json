{
  "name": "buddha-js",
  "version": "0.1.0",
  "description": "A TypeScript library that programmatically models Buddhist concepts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "buddha": "./dist/cli.mjs",
    "buddha-mcp": "./dist/mcp.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "build:cli": "tsup --config tsup.cli.ts",
    "build:mcp": "tsup --config tsup.mcp.ts",
    "build:plugin": "npm run build:mcp && mkdir -p plugin/dist && cp dist/mcp.mjs plugin/dist/mcp.mjs",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test:run && npm run build && npm run build:cli && npm run build:mcp && npm run build:plugin"
  },
  "keywords": [
    "buddhism",
    "philosophy",
    "meditation",
    "mindfulness",
    "dharma",
    "four-noble-truths",
    "eightfold-path",
    "dependent-origination"
  ],
  "author": "Askar Zhakenov <askar@zhakenov.pro>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askarzh/Buddha.js.git"
  },
  "homepage": "https://github.com/askarzh/Buddha.js#readme",
  "bugs": {
    "url": "https://github.com/askarzh/Buddha.js/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  }
}
